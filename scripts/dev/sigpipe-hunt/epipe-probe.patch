+// TEMPORARY (not to commit): a writer the probe should name.
+struct EPipeProbeCheck {
+    @Test(.enabled(if: ProcessInfo.processInfo.environment["VS_EPIPE_SELFTEST"] == "1"))
+    func aLoopWritingToADeadPipe() async {
+        var pair: [Int32] = [-1, -1]
+        _ = pipe(&pair)
+        close(pair[0])
+        let fd = pair[1]
+        await withCheckedContinuation { (done: CheckedContinuation<Void, Never>) in
+            Thread.detachNewThread {
+                let end = Date().addingTimeInterval(1)
+                while Date() < end { _ = Darwin.write(fd, "x", 1) }
+                close(fd)
+                done.resume()
+            }
+        }
+    }
+}
