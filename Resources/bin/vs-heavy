#!/bin/bash
# vs-heavy [--as WHAT] [--timeout TIME] COMMAND [ARGS...]: runs COMMAND in one of the Mac-wide slots for heavy work (a
# full test suite, a release build), so that every project's workers, merges and audits run at most N at a time on this
# Mac. Two suites side by side starved each other and the benches (3–4 min each at load 30–50, measured 2026-10-21); one
# slot, though, let a 38-minute pytest hold up every project's builds, suites and merges (2026-10-22). N is
# VIBESWITCHER_HEAVY_SLOTS (a project's heavy_slots gives its sessions that), else Settings' Mac-wide count
# (~/.vibeswitcher/mac-limits.json's heavySlots: 1 to the cores, the cores ÷ 6 while unset, 2 on a 12-core Mac); while
# Boost mode is on (boost.json says so and was written in the last 150 s) it's raised to boost's heavySlots (1 to the
# cores): the same count the leads' merges and audits take (`MacLimits.heavySlotsInForce`). While every slot is held, this
# run waits in line (first come, first served, with merges and audits too), saying its place ("2nd in line, behind merge
# of x (vibeswitcher)") and who holds each slot (pid, what, where, which project, how long: "long" past 30 min, and
# "idle 40 min" once its work has used almost no CPU for 10 min or more: only said, never acted on), again each time
# that changes and every 5 minutes, then runs COMMAND and exits with its status. VibeSwitcher puts it on PATH in every
# session it starts (the app bundle's Contents/Resources/bin); merge and an audit's shared run take a slot around their
# test command too (`TestLock` in VibeCore).
#
# COMMAND gets VS_HEAVY_CORES, its share of the Mac: the cores ÷ the slots, rounded up, at least 2 (4 on a 12-core Mac
# with 3 slots). A slot is one job's room, not a whole Mac: on 2026-11-01 a merge's swift-frontend ran 9 processes at
# ~900 % CPU and two node --test runs about 9 cores each, all inside the slots, and the load reached 62–84. Builds and
# test runners take it as their parallelism (`swift build -j $VS_HEAVY_CORES`, `node --test
# --test-concurrency=$VS_HEAVY_CORES`, `make -j $VS_HEAVY_CORES`); scripts/test.sh and scripts/build-app.sh do. It's the
# share whether or not the other slots are held: a job sized to a calm Mac when it starts can't shrink when two more
# start beside it. Under a holder (below) a VS_HEAVY_CORES already set is kept, else it's worked out the same way
# (merge and audits give their test command theirs, `TestLock.coreBudget`). VIBESWITCHER_HEAVY_NCPU stands in for the
# Mac's core count (tests).
#
# Slot 1 is a flock on $VIBESWITCHER_TEST_LOCK_DIR/test-build.lock (default /private/tmp/vibeswitcher-<uid>/), slot k
# on test-build-k.lock beside it (an older vs-heavy, with only test-build.lock, contends for slot 1). The slot taken is
# held on this script's fd 9 and its supervisor's (below): the kernel lets go of it once both have exited, so a run that
# died leaves no lock behind. Its slot's .holder note (its pid, what, where and since when; then when it took the slot,
# when its pid's process started, and its project and task, as TestLock reads them) goes when it exits; one a kill -9
# left names a pid that's gone, and readers take it as saying nothing (the next holder writes its own). macOS has no
# flock(1): /usr/bin/perl takes it on one of the slots' fds and exits, and the lock stays with the script's fd.
#
# The slot is let go only once COMMAND has ended: killed while it ran (`kill <pid>` of this script, how workers stop
# what they started), this script freed the slot while a suite ran on, unlocked (process audit 2026-10-22, #4). COMMAND
# runs in a process group of its own, started and watched by a supervisor (perl, in a group of its own too, holding the
# slot with this script): TERM, INT (Ctrl-C) and HUP to this script go to the supervisor, which sends them on to
# COMMAND's group and every descendant of COMMAND (one in a group of its own too), gives them 10 s, kills what's left,
# and only then exits, and this script after it. When
# this script goes without a word (kill -9), the supervisor ends the group the same way. COMMAND ending by itself ends
# the run: what it left running in its group is left alone (a daemon it started), and doesn't hold the slot (it hasn't
# the fd). COMMAND's stdin is /dev/null when this script's is a terminal: its group isn't the terminal's, and a read
# there would stop it.
#
# No holder keeps a slot for good (a TGE pytest sat at 0 % CPU for 3 h 23 min holding the only one, 2026-10-22):
# --timeout TIME (VIBESWITCHER_HEAVY_TIMEOUT, else 60 min; "90" or "90m" minutes, "30s" seconds, "2h" hours) ends
# COMMAND's group the same way once it has run that long, and this script exits 124. While COMMAND runs, the
# supervisor looks at its tree's CPU time every minute and touches the slot's .active note (its text this script's
# "pid P") whenever the group used 1 % of a core or more since (or wrote to a watched output, or started a process):
# how long ago it was last touched is how long the holder has been idle, for waiters here and TestLock's (status, the
# witness).
#
# Nor does a run that makes no progress keep it until then (five test runs sat at 0 % CPU for 30–60 min holding a slot
# and the merge queue, 2026-11-05 and 06, one at load 4.2 on 12 cores): --stall TIME (VIBESWITCHER_HEAVY_STALL, else
# 10 min; "0" or "off": never) ends COMMAND's group the same way, exit 124, once it has gone that long with no progress
# while the Mac's 1-minute load is under load_threshold (mac-limits.json's loadThreshold, else twice the cores; raised
# while boosted; VIBESWITCHER_HEAVY_LOAD stands in for the load, tests): no new output, its group under 1 % of a core,
# no new process in it. A loaded Mac starving it isn't a hang: while the load is at or above the threshold, its
# silence isn't counted (nor is a look that comes half a --stall late: it starts the count again). Both --timeout and
# --stall count the time the Mac was awake (CLOCK_UPTIME_RAW, as a merge's run does): sleep isn't a run's time, and on
# 2026-11-08 a merge's run was called hung with 4.9 minutes awake out of 51.8. It's looked at at least 4 times a --stall. Its output is watched where it can be seen without coming between COMMAND and it: a file
# (its size) or a terminal (when it was last written); when either of its outputs goes elsewhere (a pipe, /dev/null),
# --stall is off and only --timeout ends it. Stopping it, it says so first ("no progress for 10 min …; last test
# started: X"), then its processes (pid, parent, state, CPU seconds, name: the kernel's records, no debugger) and,
# from a file, its output's last 60 lines.
#
# COMMAND gets VIBESWITCHER_TEST_LOCK naming the slot: a vs-heavy under one that holds any of this folder's slots (a
# test script the merge's test command runs, a suite under a wrapped build) runs its command at once rather than wait
# for its own ancestor (the holder's own timeout and group are its).
# --as WHAT: who the holder note names (default: the command line).
# (vs-heavy [--as WHAT] [--timeout TIME] [--stall TIME] COMMAND [ARGS...])
set -uo pipefail

# TIME as seconds: "90" and "90m" minutes, "30s" seconds, "2h" hours; above 0. Fails on anything else.
seconds_of() {
    [[ $1 =~ ^([0-9]+)([smh]?)$ ]] && (( 10#${BASH_REMATCH[1]} > 0 )) || return 1
    case ${BASH_REMATCH[2]} in
        s) echo $(( 10#${BASH_REMATCH[1]} )) ;;
        h) echo $(( 10#${BASH_REMATCH[1]} * 3600 )) ;;
        *) echo $(( 10#${BASH_REMATCH[1]} * 60 )) ;;
    esac
}
# --stall's TIME as seconds, as `seconds_of`, or 0 for "0", "0m", "0s" and "off" (never). Fails on anything else.
stall_of() {
    [[ $1 == off || $1 =~ ^0+[smh]?$ ]] && { echo 0; return 0; }
    seconds_of "$1"
}
usage="usage: vs-heavy [--as WHAT] [--timeout TIME] [--stall TIME] COMMAND [ARGS...]: runs COMMAND in a Mac-wide slot for heavy work"

what=""
timeout=$(seconds_of "${VIBESWITCHER_HEAVY_TIMEOUT:-}") || timeout=3600
stall=$(stall_of "${VIBESWITCHER_HEAVY_STALL:-}") || stall=600
while (( $# > 0 )); do
    case $1 in
        --as) what=${2:?vs-heavy --as WHAT COMMAND [ARGS...]}; shift 2 ;;
        --timeout) timeout=$(seconds_of "${2:-}") || { echo "vs-heavy: --timeout ${2:-}: give minutes (90, 90m), seconds (30s) or hours (2h)" >&2; exit 2; }; shift 2 ;;
        --stall) stall=$(stall_of "${2:-}") || { echo "vs-heavy: --stall ${2:-}: give minutes (10, 10m), seconds (90s), hours (1h), or off" >&2; exit 2; }; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
if (( $# == 0 )); then
    echo "$usage" >&2
    exit 2
fi
[[ -n $what ]] || what=$(printf '%s' "$*" | tr '\n' ' ' | cut -c 1-120)

lock_dir=${VIBESWITCHER_TEST_LOCK_DIR:-/private/tmp/vibeswitcher-$(id -u)}
# Set on Linux (uname -s), which answers some of what this asks the Mac in other words; empty on the Mac, where nothing
# changes. Its first: there is no /private/tmp there, and the slots are kept under /tmp itself.
linux=""
[[ $(uname -s) == Linux ]] && linux=1
[[ -n $linux && -z ${VIBESWITCHER_TEST_LOCK_DIR:-} ]] && lock_dir=/tmp/vibeswitcher-$(id -u)
# As TestLock names it (no trailing slash), so a run under a holder of the Swift side's slot knows it.
while [[ $lock_dir == */ && $lock_dir != / ]]; do lock_dir=${lock_dir%/}; done

ncpu=${VIBESWITCHER_HEAVY_NCPU:-}
# Linux: nproc, the cores this may run on (it has no hw.ncpu).
[[ -n $linux ]] && { [[ $ncpu =~ ^[0-9]+$ ]] && (( 10#$ncpu >= 1 )) || ncpu=$(nproc 2>/dev/null); }
[[ $ncpu =~ ^[0-9]+$ ]] && (( 10#$ncpu >= 1 )) || ncpu=$(sysctl -n hw.ncpu 2>/dev/null)
# Where the sysctl command fails (Codex's sandbox: it asks for each name's format first, which the seatbelt refuses,
# and a Codex worker's runs counted 4 cores and one slot), getconf's count: sysconf reads hw.ncpu, which it allows.
[[ $ncpu =~ ^[0-9]+$ ]] && (( 10#$ncpu >= 1 )) || ncpu=$(getconf _NPROCESSORS_ONLN 2>/dev/null)
[[ $ncpu =~ ^[0-9]+$ ]] && (( 10#$ncpu >= 1 )) || ncpu=4
ncpu=$(( 10#$ncpu ))
own=${VIBESWITCHER_HEAVY_SLOTS:-}
[[ $own =~ ^[0-9]+$ ]] && (( 10#$own >= 1 )) && own=$(( 10#$own )) || own=""
# VibeSwitcher's folder, as VibePaths.root finds it: VIBESWITCHER_HOME, else .vibeswitcher in the home.
vs_root=${VIBESWITCHER_HOME:-}
[[ $vs_root == /* ]] || { vs_home=${CFFIXED_USER_HOME:-}; [[ $vs_home == /* ]] || vs_home=${HOME:-}; vs_root=$vs_home/.vibeswitcher; }
# Settings' count and boost's, read as MacLimits.current and BoostState.load read them (clamped, a stale boost.json off).
slots=$(/usr/bin/perl -MJSON::PP -e '
    my ($root, $ncpu, $own) = @ARGV;
    sub json { open(my $h, "<", shift) or return undef; local $/; my $j = eval { JSON::PP->new->decode(scalar <$h>) }; ref $j eq "HASH" ? $j : undef }
    sub count { my ($v, $default) = @_; return $default unless defined $v && !ref $v && $v =~ /^-?[0-9]+$/; $v < 1 ? 1 : $v > $ncpu ? $ncpu : $v + 0 }
    my $default = int($ncpu / 6) || 1;
    my $limits = json("$root/mac-limits.json");
    my $slots = $own ne "" ? $own : count($limits ? $limits->{heavySlots} : undef, $default);
    my $set = $limits ? $limits->{loadThreshold} : undef;
    my $limit = defined $set && !ref $set && $set =~ /^[0-9]+(\.[0-9]+)?$/ && $set > 0 ? $set + 0 : 2 * $ncpu;
    my $boost = json("$root/boost.json");
    # As Swift decodes it: on a JSON true, why, limits an object and at a number, else no boost.
    if ($boost && JSON::PP::is_bool($boost->{on}) && $boost->{on} && defined $boost->{why} && !ref $boost->{why}
        && ref $boost->{limits} eq "HASH" && defined $boost->{at} && $boost->{at} =~ /^[0-9]+(\.[0-9]+)?$/
        && time - $boost->{at} <= 150 && $boost->{at} <= time + 150) {
        my $raised = count($boost->{limits}{heavySlots}, 3);
        $slots = $raised if $raised > $slots;
        my $boosted = $boost->{limits}{loadThreshold};
        $boosted = 36 unless defined $boosted && !ref $boosted && $boosted =~ /^[0-9]+(\.[0-9]+)?$/ && $boosted > 0;
        $limit = $boosted if $boosted > $limit;
    }
    print "$slots $limit";
' "$vs_root" "$ncpu" "$own" 2>/dev/null)
# load_threshold (as MacLimits.loadLimit, raised while boosted): above it, a run's silence isn't counted (--stall).
load_limit=${slots#* }
slots=${slots%% *}
[[ $load_limit =~ ^[0-9]+(\.[0-9]+)?$ ]] || load_limit=$(( 2 * ncpu ))
if ! [[ $slots =~ ^[0-9]+$ ]] || (( 10#$slots < 1 )); then
    slots=${own:-$(( ncpu / 6 ))}
    (( slots >= 1 )) || slots=1
fi
slots=$(( 10#$slots ))
# A slot's share of the cores: ÷ slots, rounded up, at least 2.
cores=$(( (ncpu + slots - 1) / slots ))
(( cores >= 2 )) || cores=2

# Under a holder of one of these very slots: it's ours already, and so is its share (its own, when it gave one).
held=${VIBESWITCHER_TEST_LOCK:-}
if [[ $held == "$lock_dir/test-build.lock" || $held == "$lock_dir"/test-build-[0-9]*.lock ]]; then
    [[ ${VS_HEAVY_CORES:-} =~ ^[0-9]+$ ]] && (( 10#$VS_HEAVY_CORES >= 1 )) || export VS_HEAVY_CORES=$cores
    exec "$@"
fi

mkdir -p -m 700 "$lock_dir" || { echo "vs-heavy: can't make $lock_dir for the heavy-work slots" >&2; exit 1; }
# /private/tmp is everyone's: a folder someone else made there (or a link) isn't taken as this user's.
[[ -O $lock_dir && ! -L $lock_dir ]] || { echo "vs-heavy: $lock_dir isn't a folder of yours: the heavy-work slots can't be kept there" >&2; exit 1; }

# Slot k's file, on fd 19+k while this waits.
slot_file() { (( $1 == 1 )) && echo "$lock_dir/test-build.lock" || echo "$lock_dir/test-build-$1.lock"; }
fds=()
for (( k = 1; k <= slots; k++ )); do
    file=$(slot_file "$k")
    eval "exec $(( 19 + k ))>> \"\$file\"" || { echo "vs-heavy: can't open $file" >&2; exit 1; }
    fds+=("$(( 19 + k )):$file")
done

# Waits in line for a slot and prints its number: takes a ticket (TestLock's line, below), then the first slot no one
# before it may take (a flock on its fd), however long it takes. While it waits, it says its place in line and who
# holds each slot (from their .holder notes), again whenever that changes and every 5 minutes.
#
# The line (first come, first served; flock has none, and on 2026-10-22 a merge waited 90 minutes while later pytests
# and merges took the slot again and again), as TestLock keeps it: under a flock on queue.lock, whose text is the last
# number given, the next number is one past that (or past the highest ticket, if higher), and ticket-<n> is made with
# O_EXCL|O_EXLOCK: its text a holder's note and "slots N". Its waiter keeps it flocked until it holds a slot or gives up,
# then removes it; one that can be flocked has no waiter, and is removed and passed over. A waiter takes slot k only
# when no live ticket before its own has slots >= k. An older vs-heavy takes no ticket: it may take a slot ahead of the
# line but waits on nothing in it, so it can hold the line up only while its command runs.
taken=$(/usr/bin/perl -MFcntl=:DEFAULT,:flock -MPOSIX=strftime -e '
    my ($what, $script, $place, @slots) = @ARGV;
    # Linux has no O_EXLOCK (Fcntl dies on its name): nothing there, and a ticket is flocked before it has its name (below).
    BEGIN { *O_EXLOCK = sub () { 0 } if $^O eq "linux"; }
    my @handles;
    for my $slot (@slots) {
        my ($fd, $file) = split /:/, $slot, 2;
        open(my $fh, ">&=", $fd) or exit 2;
        push @handles, [$fh, $file];
    }
    my $n = @handles;
    (my $dir = $handles[0][1]) =~ s{/[^/]*$}{};
    sub project { my ($dir) = @_; $dir = $1 if $dir =~ m{^(.*?)/\.vibeswitcher/worktrees/}; $dir =~ s{/+$}{}; return (split m{/}, $dir)[-1]; }
    sub held_for { my ($s) = @_; return $s < 60 ? "$s s" : int($s / 60) . " min" . ($s >= 1800 ? ", long" : ""); }
    sub parse { my ($line) = @_; return $line =~ /^pid (\d+), (.*?)(?: in (\/.*))?, since [^,]*$/ ? ($1, $2, $3) : (); }
    # Who holds a slot, from its note: "pid P, WHAT in DIR (project), for 38 min, long".
    sub holder {
        my ($file) = @_;
        open(my $note, "<", "$file.holder") or return ("a run that did not say who it is", "?");
        my $line = <$note>;
        return ("a run that did not say who it is", "?") unless defined $line && length $line > 1;
        chomp $line;
        # A note naming a process that has ended says nothing: it outlived its run.
        return ("a run that did not say who it is", "?") if $line =~ /^pid (\d+),/ && !kill(0, $1) && $!{ESRCH};
        my $since = (stat($note))[9];
        my $who = $line;
        if (my ($pid, $cmd, $in) = parse($line)) { $who = "pid $pid, $cmd" . (defined $in ? " in $in (" . project($in) . ")" : ""); }
        return ($who, $line, defined $since ? time - $since : undef, idle($file, $line));
    }
    # How long the holder whose note is $line has used almost no CPU, from its .active note (when that is its own).
    sub idle {
        my ($file, $line) = @_;
        my ($pid) = $line =~ /^pid (\d+),/ or return undef;
        open(my $active, "<", "$file.active") or return undef;
        my $of = <$active>;
        return undef unless defined $of && $of =~ /^pid $pid$/;
        my $at = (stat($active))[9];
        return defined $at ? time - $at : undef;
    }
    sub numbers { opendir(my $d, $dir) or return (); my @all = map { /^ticket-(\d+)$/ ? $1 : () } readdir($d); return @all; }
    # Takes a number: its ticket, flocked from its making on $ticket.
    sysopen(my $queue, "$dir/queue.lock", O_RDWR | O_CREAT | O_NOFOLLOW, 0600) or exit 2;
    flock($queue, LOCK_EX) or exit 2;
    my $given = <$queue>;
    $given = defined $given && $given =~ /^(\d+)/ ? $1 : 0;
    for (numbers()) { $given = $_ if $_ > $given; }
    my $mine = $given + 1;
    seek($queue, 0, 0); truncate($queue, 0); syswrite($queue, "$mine\n") or exit 2;
    my $path = "$dir/ticket-$mine";
    # Linux: made as ticket.new, a name no reader of the line looks for (one a maker that died left goes first: only the
    # holder of queue.lock makes one).
    if ($^O eq "linux") { $path = "$dir/ticket.new"; unlink $path; }
    sysopen(my $ticket, $path, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_EXLOCK, 0600) or exit 2;
    # Then flocked, and only then given its name (a link, which fails on a name there is, as O_EXCL does): never seen
    # unlocked while its waiter lives, as with O_EXLOCK.
    if ($^O eq "linux") {
        flock($ticket, LOCK_EX) or exit 2;
        link($path, "$dir/ticket-$mine") or exit 2;
        unlink $path;
        $path = "$dir/ticket-$mine";
    }
    syswrite($ticket, "pid $script, $what in $place, since " . strftime("%H:%M:%S", localtime) . "\nslots $n\n");
    close($queue);
    # Out of line, removed first so no one finds it let go.
    sub leave { unlink $path; close $ticket; }
    # The live tickets before this one, first first: [what (project), slots]. One no waiter holds is removed.
    sub ahead {
        my @live;
        for my $number (sort { $a <=> $b } grep { $_ < $mine } numbers()) {
            my $file = "$dir/ticket-$number";
            sysopen(my $fh, $file, O_RDONLY | O_NOFOLLOW) or next;
            if (flock($fh, LOCK_EX | LOCK_NB)) { unlink $file; close $fh; next; }
            my @lines = <$fh>;
            chomp @lines;
            my ($slots) = map { /^slots (\d+)$/ ? $1 : () } @lines;
            my $line = defined $lines[0] && $lines[0] !~ /^slots / ? $lines[0] : "";
            my ($pid, $cmd, $in) = parse($line);
            my $name = defined $cmd ? $cmd . (defined $in ? " (" . project($in) . ")" : "") : length $line ? $line : "a run that did not say who it is";
            push @live, [$name, defined $slots ? $slots : 1e9];
        }
        return @live;
    }
    sub place {
        my @ahead = @_;
        my $p = @ahead + 1;
        my $th = ($p % 100 >= 11 && $p % 100 <= 13) ? "th" : ({1 => "st", 2 => "nd", 3 => "rd"}->{$p % 10} // "th");
        return "$p$th in line" unless @ahead;
        my @names = map { $_->[0] } @ahead[0 .. ($#ahead < 2 ? $#ahead : 2)];
        push @names, (@ahead - 3) . " more" if @ahead > 3;
        my $list = @names == 1 ? $names[0] : join(", ", @names[0 .. $#names - 1]) . " and $names[-1]";
        return "$p$th in line, behind $list";
    }
    sub take { my ($from) = @_; for my $i ($from .. $#handles) { return $i + 1 if flock($handles[$i][0], LOCK_EX | LOCK_NB); } return 0; }
    my ($start, $said, $saidAt, $got) = (time, "", 0, 0);
    while (1) {
        my @ahead = ahead();
        my $from = 0;
        for (@ahead) { $from = $_->[1] if $_->[1] > $from; }
        last if $got = take($from);
        # The script went (kill -9): out of line rather than wait for nobody.
        if (!kill(0, $script) || getppid() == 1) { leave(); exit 1; }
        my (@told, @keys);
        for my $i (0 .. $#handles) {
            my ($who, $key, $age, $idle) = holder($handles[$i][1]);
            push @keys, $key;
            push @told, "slot " . ($i + 1) . " held by $who" . (defined $age ? ", for " . held_for($age) : "")
                . (defined $idle && $idle >= 600 ? ", idle " . int($idle / 60) . " min" : "");
        }
        my $where = place(@ahead);
        my $set = join("\n", $where, @keys);
        if ($set ne $said || time - $saidAt >= 300) {
            my $all = $n == 1 ? "its one slot held" : "all $n slots held";
            print STDERR ($said eq "" ? "vs-heavy: $what: waiting for the Mac-wide test and build lock ($all, in $dir): "
                                      : "vs-heavy: $what: still waiting ($all): ") . "$where; " . join("; ", @told) . ".\n";
            ($said, $saidAt) = ($set, time);
        }
        select(undef, undef, undef, 0.5);
    }
    leave();
    printf STDERR "vs-heavy: %s: took the test and build lock (slot %d of %d) after %d s.\n", $what, $got, $n, time - $start if $said ne "";
    print $got;
' "$what" "$$" "$PWD" "${fds[@]}") || { echo "vs-heavy: couldn't take a slot of the test and build lock" >&2; exit 1; }

# Keeps the slot taken on fd 9 and lets go of the others' fds.
lock_file=$(slot_file "$taken")
exec 9>&$(( 19 + taken ))
for (( k = 1; k <= slots; k++ )); do eval "exec $(( 19 + k ))>&-"; done

# Its note (TestLock's): who, then its record: when it took the slot, when this script started (ps's elapsed time, to a
# second: with the pid, who it is), and the project and task $PWD is for (a worktree of VibeSwitcher's,
# <repo>/.vibeswitcher/worktrees/<slug>, is <repo>'s and <slug>'s).
now=$(date +%s)
started=""
elapsed=$(ps -o etime= -p $$ 2> /dev/null | tr -d ' ')
if [[ $elapsed =~ ^(([0-9]+)-)?(([0-9]+):)?([0-9]+):([0-9]+)$ ]]; then
    started=$(( now - (10#${BASH_REMATCH[2]:-0} * 86400 + 10#${BASH_REMATCH[4]:-0} * 3600 + 10#${BASH_REMATCH[5]} * 60 + 10#${BASH_REMATCH[6]}) ))
fi
project=${PWD%/} task=""
if [[ $PWD =~ ^(.*)/\.vibeswitcher/worktrees/([^/]+) ]]; then
    project=${BASH_REMATCH[1]} task=${BASH_REMATCH[2]}
fi
project=${project##*/}
# Linux: GNU date takes a time in seconds as -d @N (its -r is a file's time); the words below are the Mac's.
if [[ -n $linux ]]; then
    date() { if [[ ${1:-} == -r ]]; then command date -d "@$2" "${@:3}"; else command date "$@"; fi; }
fi
{
    echo "pid $$, $what in $PWD, since $(date -r "$now" +%H:%M:%S)"
    echo "taken $now"
    [[ -n $started ]] && echo "pid started $started"
    echo "project ${project:-/}"
    [[ -n $task ]] && echo "task $task"
} > "$lock_file.holder"
# Its work's last use of CPU (its time; touched by the supervisor).
echo "pid $$" > "$lock_file.active"
# The notes go with this run (Ctrl-C too), while the slot is still ours: only our own, so no later holder's. A kill -9
# leaves them, naming a pid that's gone, which readers (waiters here, TestLock's) take as saying nothing.
trap '[[ $(head -n 1 "$lock_file.holder" 2>/dev/null) == "pid $$, "* ]] && rm -f "$lock_file.holder"
      [[ $(head -n 1 "$lock_file.active" 2>/dev/null) == "pid $$" ]] && rm -f "$lock_file.active"' EXIT
export VIBESWITCHER_TEST_LOCK=$lock_file
export VS_HEAVY_CORES=$cores

# TERM, INT and HUP go to the supervisor (one that came before it started, once it has).
supervisor="" stopping=""
for signal in TERM INT HUP; do
    trap "stopping=$signal; [[ -n \$supervisor ]] && kill -$signal \$supervisor 2> /dev/null" "$signal"
done
# The supervisor: in a group of its own (a kill -9 of this script's group leaves it to end COMMAND's), it starts
# COMMAND in another, its id COMMAND's pid, and waits for it, holding the slot on fd 9 as this script does. Stopped
# (TERM, INT, HUP, this script gone, or past --timeout), it sends COMMAND's group the signal (TERM for the last two),
# kills what's left of it after 10 s, and exits once the group is empty: 128 + the signal, or 124 past --timeout.
# Else it exits with COMMAND's status, 128 + the signal when a signal ended it. Every minute (VIBESWITCHER_HEAVY_SAMPLE
# seconds, for tests) it reads its tree's CPU time with ps and touches .active when the tree used 1 % of a core or
# more since the look before (CPU of processes that ended in between isn't seen; new ones count whole). Its stdin is this script's
# (`<&0`: a script's background job's would be /dev/null).
/usr/bin/perl -MPOSIX=:sys_wait_h -MTime::HiRes=time -e '
    # The clocks: (the wall clock, the time the Mac was awake). VIBESWITCHER_HEAVY_CLOCK is a file standing in for both
    # ("WALL AWAKE", seconds; tests), each reading noted with a byte in its .reads beside it.
    sub clocks {
        my $given = $ENV{VIBESWITCHER_HEAVY_CLOCK} // "";
        if (length $given && open(my $in, "<", $given)) {
            my ($wall, $awake) = split " ", (scalar <$in>) // "";
            if (open(my $reads, ">>", "$given.reads")) { print $reads "."; close $reads; }
            return ($wall + 0, $awake + 0) if defined $awake;
        }
        my $awake = eval { Time::HiRes::clock_gettime(Time::HiRes::CLOCK_UPTIME_RAW()) };
        # Linux has no such clock: its monotonic one, which stands still while the machine sleeps too.
        $awake //= eval { Time::HiRes::clock_gettime(Time::HiRes::CLOCK_MONOTONIC()) } if $^O eq "linux";
        return (time, defined $awake && $awake > 0 ? $awake : time);
    }
    # What --timeout and --stall count on: the time the Mac was awake, as a merge'\''s run does (Shell.run). A Mac that
    # slept through a run gave it no time to finish, and the first look after waking would find the limit passed.
    sub now { (clocks())[1] }
    my ($script, $what, $limit, $active, $every, $stall, $loadLimit, $loadGiven, @command) = @ARGV;
    # Linux has no F_GETPATH (fcntl 50, which `report` asks for an output file by): the link under /proc names it.
    BEGIN { *CORE::GLOBAL::fcntl = sub { $_[1] == 50 ? defined($_[2] = readlink("/proc/self/fd/" . fileno($_[0]))) : CORE::fcntl($_[0], $_[1], $_[2]) } if $^O eq "linux"; }
    my $stop;
    $SIG{$_} = sub { $stop //= $_[0] } for qw(TERM INT HUP);
    POSIX::setpgid(0, 0);
    # Its outputs, when both can be watched without coming between COMMAND and them: a file (its size) or a terminal
    # (when it was last written). Else --stall is off.
    my @outputs;
    for my $fh (\*STDOUT, \*STDERR) {
        my @st = stat($fh);
        my $kind = !@st ? undef : -t $fh ? "tty" : -f _ ? "file" : undef;
        unless (defined $kind) { @outputs = (); $stall = 0; last; }
        push @outputs, [$fh, $kind, "$st[0]:$st[1]"] unless grep { $_->[2] eq "$st[0]:$st[1]" } @outputs;
    }
    # What its outputs say now: a file'\''s size, a terminal'\''s last write.
    sub mark { join ",", map { my @st = stat($_->[0]); @st ? ($_->[1] eq "file" ? $st[7] : $st[9]) : "?" } @outputs }
    # The Mac'\''s 1-minute load (VIBESWITCHER_HEAVY_LOAD for it in tests); undef when unread.
    sub load {
        return $loadGiven + 0 if $loadGiven =~ /^[0-9]+(\.[0-9]+)?$/;
        # Linux: the first number of /proc/loadavg.
        if ($^O eq "linux") { open(my $in, "<", "/proc/loadavg") or return undef; return ((scalar <$in>) // "") =~ /^([0-9]+(?:\.[0-9]+)?)/ ? $1 + 0 : undef; }
        my $out = `/usr/sbin/sysctl -n vm.loadavg 2>/dev/null`;
        return $out =~ /([0-9]+(?:[.,][0-9]+)?)/ ? do { (my $n = $1) =~ tr/,/./; $n + 0 } : undef;
    }
    my $child = fork;
    defined $child or do { print STDERR "vs-heavy: $what: could not start it: $!\n"; exit 126 };
    if ($child == 0) {
        POSIX::setpgid(0, 0);
        $SIG{$_} = "DEFAULT" for qw(TERM INT HUP QUIT);
        POSIX::close(9);
        open(STDIN, "<", "/dev/null") if -t STDIN;
        { exec { $command[0] } @command; }
        print STDERR "vs-heavy: $command[0]: $!\n";
        POSIX::_exit(127);
    }
    # Either side may run first: the group is made before anything is sent to it.
    POSIX::setpgid($child, $child);
    my ($start, $status, $timedOut) = (now(), undef, 0);
    # The user'\''s own processes, from ps: pid => [parent, group, CPU seconds, start (lstart)]; undef when it did not
    # answer in 5 s.
    sub table {
        my $ps = open(my $out, "-|", "/bin/ps", "-x", "-o", "pid=,ppid=,pgid=,time=,lstart=") or return undef;
        my @lines = eval { local $SIG{ALRM} = sub { die "late\n" }; alarm 5; my @all = <$out>; alarm 0; @all };
        alarm 0;
        if ($@) { kill "KILL", $ps; close $out; return undef; }
        close $out;
        my %table;
        for (@lines) {
            my ($pid, $ppid, $pgid, $time, $lstart) = /^\s*(\d+)\s+(\d+)\s+(\d+)\s+(\S+)\s+(.*?)\s*$/ or next;
            my $seconds = 0;
            # Linux: procps writes a time of a day or more as DD-HH:MM:SS; the days go into the hours.
            $time = ($1 * 24 + $2) . $3 if $^O eq "linux" && $time =~ /^(\d+)-(\d+)(:.*)$/;
            $seconds = $seconds * 60 + $_ for split /:/, $time;
            # Linux: procps gives whole seconds, too coarse for 1 % of a core between looks (the Mac gives hundredths):
            # its clock ticks, from /proc (the last ")" ends the name; then the state, ten fields, user and system time).
            if ($^O eq "linux" && open(my $stat, "<", "/proc/$pid/stat")) {
                $seconds = ($1 + $2) / POSIX::sysconf(POSIX::_SC_CLK_TCK()) if ((scalar <$stat>) // "") =~ /.*\)\s+\S+(?:\s+\S+){10}\s+(\d+)\s+(\d+)/s;
            }
            $table{$pid} = [$ppid, $pgid, $seconds, $lstart];
        }
        return \%table;
    }
    # COMMAND'\''s tree: its group and its descendants (one in a group of its own too: swift test starts
    # swiftpm-testing-helper in a new one, and on 2026-11-06 a helper outlived its run at 0 % CPU for 1 h 18 min), as
    # pid => its start (ps'\''s lstart), added to `$family` and kept: one whose parent has gone is launchd'\''s child by
    # the next look. Only the user'\''s own processes, each matched by its start, so a pid given again is never hit.
    # Returns the table it read (undef, and `$family` as it was, when ps did not answer).
    sub family {
        my ($family) = @_;
        my $table = table() or return undef;
        my %children;
        push @{$children{$table->{$_}[0]}}, $_ for keys %$table;
        my @walk = ($child, grep { $table->{$_}[1] == $child } keys %$table);
        push @walk, grep { exists $table->{$_} && $table->{$_}[3] eq $family->{$_} } keys %$family;
        my %seen;
        while (defined(my $pid = shift @walk)) {
            next if $seen{$pid}++;
            $family->{$pid} //= $table->{$pid}[3] if exists $table->{$pid};
            push @walk, @{$children{$pid} || []};
        }
        # What has ended (or is another process now) is no longer kept.
        for (keys %$family) { delete $family->{$_} unless exists $table->{$_} && $table->{$_}[3] eq $family->{$_}; }
        return $table;
    }
    my %tree;
    # The tree'\''s processes and their CPU seconds; undef when ps did not answer.
    sub cpu {
        my $table = family(\%tree) or return undef;
        return { map { $_ => $table->{$_}[2] } keys %tree };
    }
    # Says it made no progress for $idle seconds (at load $load), the last test its output shows executing (or that it
    # cannot tell which were), its processes, and its output'\''s last 60 lines (from a file: F_GETPATH names it).
    sub report {
        my ($idle, $load) = @_;
        my ($test, $unknown, @tail);
        for my $output (grep { $_->[1] eq "file" } @outputs) {
            my $path = "\0" x 1024;
            fcntl($output->[0], 50, $path) or next;
            $path =~ s/\0.*//s;
            open(my $in, "<", $path) or next;
            my $size = -s $in;
            seek($in, $size - 4194304, 0) if $size > 4194304;
            local $/;
            my $data = <$in>;
            next unless defined $data;
            utf8::decode($data);
            my (@started, %ended);
            my @lines = map { s/\e\[[0-9;]*m//gr =~ s/\s+$//r } split /\n/, $data;
            for (@lines) {
                my ($name, $event, $plain);
                if (/^\s*\S{1,2} Test (.+?) (started\.$|passed after |failed after |skipped(?:\.$|:| with))/) {
                    ($name, $event, $plain) = ($1, $2, 1);
                    next if $name eq "run" || $name =~ /^run with /;
                } elsif (/^\s*Test Case \x27([^\x27]+)\x27 (started|passed|failed|skipped)/) {
                    ($name, $event) = ($1, $2);
                } else { next; }
                if ($event =~ /^started/) { push @started, [$name, $plain]; } else { $ended{$name}++; }
            }
            # One start for each end, in order: two suites may have a test of one name.
            my @open = grep { !($ended{$_->[0]} && $ended{$_->[0]}--) } @started;
            # Swift Testing prints a test'\''s start before it gets a slot, so of several unfinished none can be named
            # (`MergeRerun.running`: one alone is certain); XCTest prints it as the test begins.
            my @plain = grep { $_->[1] } @open;
            my @named = grep { !$_->[1] || @plain == 1 } @open;
            $test = $named[-1][0] if @named;
            $unknown = @plain if @plain > 1;
            my @kept = grep { length } @lines;
            @tail = @kept > 60 ? @kept[-60 .. -1] : @kept;
            last;
        }
        my @processes;
        family(\%tree);
        if (open(my $ps, "-|", "/bin/ps", "-x", "-o", "pid=,ppid=,stat=,time=,comm=")) {
            for (<$ps>) { my @row = split " ", $_, 5; push @processes, join(" ", @row) =~ s/\s+$//r if exists $tree{$row[0]}; }
            close $ps;
        }
        # Linux: comm is the name alone, cut at 15 bytes; the Mac names what the process was started as (/usr/bin/perl),
        # its argv[0], which /proc has.
        if ($^O eq "linux") {
            for (@processes) {
                my ($pid) = /^(\d+)/;
                open(my $in, "<", "/proc/$pid/cmdline") or next;
                my ($argv0) = split /\0/, (scalar <$in>) // "";
                s/^((?:\S+ ){4}).*/$1$argv0/ if defined $argv0 && length $argv0;
            }
        }
        my $min = $idle >= 60 ? int($idle / 60 + 0.5) . " min" : int($idle + 0.5) . " s";
        my $at = defined $load ? sprintf("at load %.1f under load_threshold %s", $load, $loadLimit + 0) : "load unread";
        binmode(STDERR, ":utf8");
        print STDERR "vs-heavy: $what: no progress for $min (no new output and under 1 % of a core, $at): stopping it, with everything it started (exit 124); "
            . (defined $test ? "last test started: $test"
               : $unknown ? "$unknown tests printed their start and never finished, but Swift Testing prints that line before a test gets a slot to run in, so the output can'\''t say which of them were running"
               : "no test in its output started and never finished") . ".\n";
        print STDERR "vs-heavy: its processes (pid, parent, state, CPU time, name):\n" . join("", map { "    $_\n" } @processes) if @processes;
        print STDERR "vs-heavy: its output'\''s last " . scalar(@tail) . " lines:\n" . join("", map { "    $_\n" } @tail) if @tail;
    }
    # Looked at often enough that a few looks fit in --stall: its first only sets where CPU starts from.
    $every = $stall / 4 if $stall > 0 && $every > $stall / 4;
    my ($seen, $next, $looked) = (undef, now() + $every, now());
    # When it last made progress: new output, 1 % of a core or a new process in its tree, or a Mac too loaded to judge.
    my ($progressed, $marked, $loaded) = (now(), mark(), undef);
    while (1) {
        if (waitpid($child, WNOHANG) == $child) { $status = $?; last; }
        # Linux: an orphan goes to the nearest subreaper, not always pid 1, and a script killed outright is a zombie
        # that kill 0 still finds until its parent waits for it: a parent that is no longer the script says it went.
        if ($^O eq "linux" && !defined $stop && getppid() != $script) {
            print STDERR "vs-heavy: $what: vs-heavy (pid $script) went: stopping it.\n";
            $stop = "TERM";
        }
        if (!defined $stop && (getppid() == 1 || !kill(0, $script))) {
            print STDERR "vs-heavy: $what: vs-heavy (pid $script) went: stopping it.\n";
            $stop = "TERM";
        }
        if (!defined $stop && now() - $start >= $limit) {
            my $past = $limit % 60 ? "$limit s" : $limit / 60 . " min";
            print STDERR "vs-heavy: $what: ran past $past (--timeout): stopping it, with everything it started (exit 124).\n";
            ($stop, $timedOut) = ("TERM", 1);
        }
        last if defined $stop;
        if (now() >= $next) {
            my $wrote = mark();
            my $busy = $wrote ne $marked;
            if (my $now = cpu()) {
                # The first look only sets where it starts from.
                my $used = 0;
                $used += $now->{$_} - (exists $seen->{$_} ? $seen->{$_} : 0) for $seen ? keys %$now : ();
                $busy ||= $used >= 0.01 * $every || grep { !exists $seen->{$_} } keys %$now if $seen;
                $seen = $now;
            } else {
                # Its group unread: nothing is stopped on what was not seen.
                $busy = 1;
            }
            utime(undef, undef, $active) if $busy;
            $loaded = load();
            # A look this late (this supervisor was starved) saw nothing of the time between: a fresh start, not silence.
            my $late = now() - $looked >= $every + $stall / 2;
            $progressed = now() if $busy || $late || (defined $loaded && $loaded >= $loadLimit);
            ($marked, $looked) = ($wrote, now());
            $next = now() + $every;
            # Judged only at a look, on what that look saw.
            if ($stall > 0 && now() - $progressed >= $stall) {
                report(now() - $progressed, $loaded);
                ($stop, $timedOut) = ("TERM", 1);
                last;
            }
        }
        select(undef, undef, undef, 0.1);
    }
    # Stopping it ends its tree (as the looks have kept it, then as it is now): its group and every process it started.
    sub signal_family { my ($signal, $family) = @_; kill $signal, -$child; kill $signal, $_ for grep { $_ != $child } keys %$family; }
    if (defined $stop) {
        family(\%tree);
        signal_family($stop, \%tree);
        my ($end, $killed) = (time + 10, 0);
        while (1) {
            $status //= $? if waitpid($child, WNOHANG) == $child;
            family(\%tree);
            last if defined $status && !kill(0, -$child) && !grep { $_ != $child } keys %tree;
            if (time >= $end) {
                last if $killed;
                signal_family("KILL", \%tree);
                ($end, $killed) = (time + 5, 1);
            }
            select(undef, undef, undef, 0.05);
        }
        exit 124 if $timedOut;
        exit 128 + ({TERM => 15, INT => 2, HUP => 1}->{$stop});
    }
    exit($status & 127 ? 128 + ($status & 127) : $status >> 8);
' "$$" "$what" "$timeout" "$lock_file.active" "${VIBESWITCHER_HEAVY_SAMPLE:-60}" "$stall" "$load_limit" "${VIBESWITCHER_HEAVY_LOAD:-}" "$@" <&0 &
supervisor=$!
[[ -n $stopping ]] && kill -"$stopping" "$supervisor" 2> /dev/null
# A trap ends a wait early: waited for again while the supervisor is there.
status=0
while :; do
    wait "$supervisor"
    status=$?
    kill -0 "$supervisor" 2> /dev/null || break
done
exit "$status"
