#!/bin/bash
# vs-vault request --workspace NAME --from WALLET --chain ID --to ADDRESS --amount BASE_UNITS --reason TEXT [...]:
# files a transaction request from this session (vs-vault help says every option). VibeSwitcher puts it on PATH in
# every session it starts (the app bundle's Contents/Resources/bin, as vs-heavy). The request shows as a card in the
# session's chat; nothing goes to the vault until the user presses Send to vault there, and the vault's answers come
# back to the session as messages. It runs the app's tool server binary in its filing mode (`VaultAsk` in VibeCore),
# which checks the request with the vault's own parser and refuses what the format doesn't take.
here="$(cd "$(dirname "$0")" && pwd)"
exec "$here/../../MacOS/vibeswitcher-mcp" --request-transaction "$@"
